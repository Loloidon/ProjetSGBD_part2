<Window x:Class="ProjetSGBD_part_2_THIJSSEN_LOIC_WPF.CompatibiliteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Compatibilités" Height="400" Width="750">

    <Grid Margin="10">
        <StackPanel>
            <TextBlock Text="Gestion des compatibilités"
                       FontSize="22"
                       FontWeight="Bold"
                       Margin="0,0,0,15"/>

            <WrapPanel>
                <TextBox x:Name="txtIdAnimal"
                         Width="100"
                         Margin="5"
                         Text="ID animal"/>

                <ComboBox x:Name="cmbType"
                          Width="150"
                          Margin="5"
                          SelectedIndex="0">
                    <ComboBoxItem Content="chat"/>
                    <ComboBoxItem Content="chien"/>
                    <ComboBoxItem Content="jeune enfant"/>
                    <ComboBoxItem Content="enfant"/>
                    <ComboBoxItem Content="jardin"/>
                    <ComboBoxItem Content="poney"/>
                </ComboBox>

                <ComboBox x:Name="cmbValeur"
                          Width="120"
                          Margin="5"
                          SelectedIndex="0">
                    <ComboBoxItem Content="oui"/>
                    <ComboBoxItem Content="non"/>
                    <ComboBoxItem Content="non teste"/>
                </ComboBox>

                <TextBox x:Name="txtDescription"
                         Width="250"
                         Margin="5"
                         Text="Description"/>
            </WrapPanel>

            <WrapPanel HorizontalAlignment="Center" Margin="0,30,0,0">
                <Button Content="Ajouter compatibilité"
                        Width="180"
                        Height="35"
                        Margin="5"
                        Click="btnAjouter_Click"/>

                <Button Content="Supprimer compatibilité"
                        Width="190"
                        Height="35"
                        Margin="5"
                        Click="btnSupprimer_Click"/>
            </WrapPanel>
        </StackPanel>
    </Grid>
</Window>