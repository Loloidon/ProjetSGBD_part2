<Window x:Class="ProjetSGBD_part_2_THIJSSEN_LOIC_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Refuge Animaux" Height="600" Width="400">
    <StackPanel Margin="30,30,30,30">
        <TextBlock Text="Refuge Animaux"
                   FontSize="24"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,30"/>

        <Button x:Name="btnAnimaux"
        Content="Animaux"
        Height="40"
        Margin="0,5"
        Click="btnAnimaux_Click"/>
        <Button Content="Contacts"
        Height="40"
        Margin="0,5"
        Click="btnContacts_Click"/>
        <Button Content="Adoptions" 
                Height="40"               
                Margin="0,5"
                Click="btnAdoptions_Click"/>
        <Button Content="Familles d'accueil"
        Height="40"
        Margin="0,5"
        Click="btnAccueilFamille_Click"/>
        <Button Content="Vaccinations"
        Height="40"
        Margin="0,5"
        Click="btnVaccins_Click"/>
        <Button Content="Compatibilités"
        Height="40"
        Margin="0,5"
        Click="btnCompatibilites_Click"/>
    </StackPanel>
</Window>