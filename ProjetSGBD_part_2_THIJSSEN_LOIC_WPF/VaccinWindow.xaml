<Window x:Class="ProjetSGBD_part_2_THIJSSEN_LOIC_WPF.VaccinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vaccins" Height="550" Width="800">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Gestion des vaccins"
                       FontSize="22"
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>

            <WrapPanel>
                <TextBox x:Name="txtIdAnimal" Width="100" Margin="5" Text="ID animal"/>
                <TextBox x:Name="txtIdVaccin" Width="100" Margin="5" Text="ID vaccin"/>
                <TextBox x:Name="txtDateVaccination" Width="130" Margin="5" Text="yyyy-mm-dd"/>
            </WrapPanel>
        </StackPanel>

        <DataGrid x:Name="dgVaccins"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  Margin="0,10,0,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID vaccin" Binding="{Binding IdVaccin}" Width="100"/>
                <DataGridTextColumn Header="Nom vaccin" Binding="{Binding NomVaccin}" Width="250"/>
                <DataGridTextColumn Header="Statut" Binding="{Binding Statut}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>

        <WrapPanel Grid.Row="2" HorizontalAlignment="Center">
            <Button Content="Afficher vaccins" Width="160" Height="35" Margin="5" Click="btnAfficherVaccins_Click"/>
            <Button Content="Vaccins d'un animal" Width="170" Height="35" Margin="5" Click="btnVaccinsAnimal_Click"/>
            <Button Content="Ajouter vaccination" Width="170" Height="35" Margin="5" Click="btnAjouterVaccination_Click"/>
        </WrapPanel>
    </Grid>
</Window>