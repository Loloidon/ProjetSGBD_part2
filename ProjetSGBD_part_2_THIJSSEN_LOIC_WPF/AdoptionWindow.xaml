<Window x:Class="ProjetSGBD_part_2_THIJSSEN_LOIC_WPF.AdoptionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Adoptions" Height="550" Width="900">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Gestion des adoptions"
                       FontSize="22"
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>

            <WrapPanel>
                <TextBox x:Name="txtIdProcessus" Width="100" Margin="5" Text="ID adoption"/>
                <TextBox x:Name="txtDateDemande" Width="130" Margin="5" Text="yyyy-mm-dd"/>
                <TextBox x:Name="txtIdAnimal" Width="100" Margin="5" Text="ID animal"/>
                <TextBox x:Name="txtIdContact" Width="100" Margin="5" Text="ID contact"/>
                <ComboBox x:Name="cmbStatut" Width="170" Margin="5" SelectedIndex="0">
                    <ComboBoxItem Content="demande"/>
                    <ComboBoxItem Content="acceptee"/>
                    <ComboBoxItem Content="refuse"/>
                    <ComboBoxItem Content="rejet_environnement"/>
                    <ComboBoxItem Content="rejet_comportement"/>
                </ComboBox>
            </WrapPanel>
        </StackPanel>

        <DataGrid x:Name="dgAdoptions"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  Margin="0,10,0,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding IdProcessus}" Width="70"/>
                <DataGridTextColumn Header="Date" Binding="{Binding DateDemande}" Width="140"/>
                <DataGridTextColumn Header="Statut" Binding="{Binding StatutAdoption}" Width="120"/>
                <DataGridTextColumn Header="Animal" Binding="{Binding NomAnimal}" Width="150"/>
                <DataGridTextColumn Header="Nom contact" Binding="{Binding NomContact}" Width="150"/>
                <DataGridTextColumn Header="Prénom contact" Binding="{Binding PrenomContact}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>

        <WrapPanel Grid.Row="2" HorizontalAlignment="Center">
            <Button Content="Lister adoptions" Width="150" Height="35" Margin="5" Click="btnLister_Click"/>
            <Button Content="Ajouter demande" Width="150" Height="35" Margin="5" Click="btnAjouter_Click"/>
            <Button Content="Modifier statut" Width="150" Height="35" Margin="5" Click="btnModifierStatut_Click"/>
        </WrapPanel>
    </Grid>
</Window>