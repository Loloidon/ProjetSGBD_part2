<Window x:Class="ProjetSGBD_part_2_THIJSSEN_LOIC_WPF.ContactWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Contacts" Height="600" Width="900">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Gestion des contacts" FontSize="22" FontWeight="Bold" Margin="0,0,0,10"/>

            <WrapPanel>
                <TextBox x:Name="txtId" Width="70" Margin="5" Text="ID"/>
                <TextBox x:Name="txtNom" Width="120" Margin="5" Text="Nom"/>
                <TextBox x:Name="txtPrenom" Width="120" Margin="5" Text="Prénom"/>
                <TextBox x:Name="txtRegistre" Width="130" Margin="5" Text="Registre"/>
                <TextBox x:Name="txtAdresse" Width="170" Margin="5" Text="Adresse"/>
                <TextBox x:Name="txtGsm" Width="120" Margin="5" Text="GSM"/>
                <TextBox x:Name="txtMail" Width="170" Margin="5" Text="Mail"/>
            </WrapPanel>
        </StackPanel>

        <DataGrid x:Name="dgContacts"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  Margin="0,10,0,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding IdContact}" Width="60"/>
                <DataGridTextColumn Header="Nom" Binding="{Binding Nom}" Width="120"/>
                <DataGridTextColumn Header="Prénom" Binding="{Binding Prenom}" Width="120"/>
                <DataGridTextColumn Header="Registre" Binding="{Binding Registre}" Width="130"/>
                <DataGridTextColumn Header="Adresse" Binding="{Binding Adresse}" Width="180"/>
                <DataGridTextColumn Header="GSM" Binding="{Binding Gsm}" Width="120"/>
                <DataGridTextColumn Header="Mail" Binding="{Binding Mail}" Width="180"/>
            </DataGrid.Columns>
        </DataGrid>

        <WrapPanel Grid.Row="2" HorizontalAlignment="Center">
            <Button Content="Lister contacts" Width="140" Height="35" Margin="5" Click="btnLister_Click"/>
            <Button Content="Afficher par ID" Width="140" Height="35" Margin="5" Click="btnAfficherUn_Click"/>
            <Button Content="Ajouter" Width="140" Height="35" Margin="5" Click="btnAjouter_Click"/>
            <Button Content="Modifier" Width="140" Height="35" Margin="5" Click="btnModifier_Click"/>
            <Button Content="Supprimer" Width="140" Height="35" Margin="5" Click="btnSupprimer_Click"/>
        </WrapPanel>
    </Grid>
</Window>